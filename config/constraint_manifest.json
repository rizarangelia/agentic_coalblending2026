  "constraints": {
    "model_1": {
      "rule": "total_brand >= deal",
      "hard": true
    },
    "model_2": {
      "rule": "total_brand <= multiplier * deal",
      "multiplier": 4,
      "hard": true
    },
    "model_3": {
      "rule": "total_site <= available_site",
      "hard": true
    },
    "model_4": {
      "rule": "grand_total <= total_plan_kapasitas",
      "scope": "TOTAL_ONLY",
      "hard": true,
      "warning_check": "per_jetty (non-binding, flag di dashboard jika terlampaui)"
    },
    "model_5": {
      "rule": "x=0 jika allowance=0",
      "hard": true
    },
    "model_6": {
      "rule": "weighted_cv_brand >= cv_min_reject",
      "toleransi_tambahan": 0,
      "hard": true
    },
    "model_7": {
      "rule": "weighted_cv_brand <= cv_max_typical",
      "hard": true
    },
    "model_8": {
      "rule": "closing_site >= cs_min",
      "hard": true
    },
    "model_9": {
      "rule": "closing_site <= cs_max",
      "hard": true
    }
  },
  "closing_stock_band_simulasi": {
    "Lati": {
      "min": 100000,
