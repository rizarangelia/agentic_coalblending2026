  "input_runtime": {
    "opening_stock": {
      "file": "opening stock status.xls",
      "kolom": [
        "site",
        "volume_mt",
        "cv_gar"
      ],
      "cadence": "tanggal 1"
    },
    "coal_getting": {
      "file": "R3MMP.xls",
      "kolom": [
        "site",
        "volume_mt",
        "cv_gar"
      ],
      "cadence": "tanggal 3-5"
    },
    "barging": {
      "file": "Cargo supply.xls",
      "kolom": [
        "origin",
        "trips",
        "volume_mt"
      ],
      "cadence": "awal bulan"
    },
    "demand_deal": {
      "file": "Sold shipment.xls",
      "kolom": [
        "brand",
        "volume_deal_mt"
      ],
      "cadence": "awal bulan"
    },
    "plan_kapasitas": {
      "sumber": "input planner",
      "kolom": [
        "jetty",
        "kapasitas_mt"
      ]
    }
  },
  "objective": {
    "formula": "maximize sum_brand( energi_brand / cv_max_typical * base_price )",
    "energi_brand": "SUMPRODUCT(x[site,brand] * cv_site)",
    "catatan": "base_price MVP1 = dummy simulasi; pricing dinamis = MVP2"
  }
