# === CoalBlend AI — environment ===
# Salin file ini ke .env lalu isi nilai asli. .env di-gitignore; jangan commit rahasia.

# --- Postgres (defaultdb) — DB yang SAMA dengan sumber data Metabase ----------
# Setiap upload & run blending di web ditulis ke DB ini; Metabase otomatis update.
# Format: postgresql://USER:PASSWORD@HOST:PORT/defaultdb
# Postgres cloud (Aiven/DigitalOcean/Supabase) butuh SSL — sslmode=require ditambah otomatis.
# Contoh Aiven : postgresql://avnadmin:AVNS_xxx@pg-xxx.aivencloud.com:5432/defaultdb?sslmode=require
# Contoh DO    : postgresql://doadmin:xxx@db-xxx.ondigitalocean.com:25060/defaultdb?sslmode=require
# Kosongkan untuk menonaktifkan DB (app tetap jalan pakai file JSON di output/).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/defaultdb?sslmode=require

# --- Data Docked (datadocked.com) — vessel/AIS tracking API ------------------
# Ambil key di https://datadocked.com/dashboard/my_keys — free tier 20 kredit uji.
DATADOCKED_API_KEY=your_key_here
